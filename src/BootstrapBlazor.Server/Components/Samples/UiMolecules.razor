@page "/ui-molecules"
@namespace BootstrapBlazor.Server.Components.Samples
@using BootstrapBlazor.Components

<h3>UI Kit — Composite Molecules</h3>

<DemoBlock Title="SearchInput" Introduction="Search box with a clear button; raises QueryChanged." Name="SearchInput">
    <SearchInput Query="@_query" QueryChanged="OnQueryChanged" Placeholder="Search models..." />
    <div class="small text-body-secondary mt-1">Query: @_query</div>
</DemoBlock>

<DemoBlock Title="ViewToggle" Introduction="Card/row view switcher — dual button or single toggle mode." Name="ViewToggle">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <ViewToggle CurrentView="@_view" CurrentViewChanged="OnViewChanged" />
        <ViewToggle Mode="ViewToggleMode.SingleButton" CurrentView="@_view" CurrentViewChanged="OnViewChanged" />
        <span class="small text-body-secondary">View: @_view</span>
    </div>
</DemoBlock>

<DemoBlock Title="FilterButtonGroup" Introduction="Segmented filter buttons with counts." Name="FilterButtonGroup">
    <FilterButtonGroup Filters="_filters" Counts="_counts" SelectedFilter="@_filter" SelectedFilterChanged="OnFilterChanged" />
    <div class="small text-body-secondary mt-1">Filter: @_filter</div>
</DemoBlock>

<DemoBlock Title="HeaderDropDown" Introduction="Compact icon dropdown for toolbars." Name="HeaderDropDown">
    <HeaderDropDown Icon="fa-solid fa-arrow-down-wide-short" Items="_sortItems" SelectedValueChanged="OnSortChanged" />
    <span class="small text-body-secondary ms-2">Sort: @_sort</span>
</DemoBlock>

<DemoBlock Title="FeatureCard" Introduction="Icon + title + description card with call-to-action button." Name="FeatureCard">
    <div class="row g-3">
        <div class="col-md-4">
            <FeatureCard Icon="fa-solid fa-key" Title="Connect a provider" Description="Add an API key and discover its models instantly." ButtonText="Connect" IconColor="text-primary" />
        </div>
        <div class="col-md-4">
            <FeatureCard Icon="fa-solid fa-flask" Title="Benchmark models" Description="Run arena comparisons across providers." ButtonText="Run" ButtonColor="Color.Success" IconColor="text-success" />
        </div>
    </div>
</DemoBlock>

<DemoBlock Title="MiniCard" Introduction="Small colour-coded info card." Name="MiniCard">
    <div class="row g-3">
        <div class="col-6 col-md-3"><MiniCard Title="Requests" Icon="fa-solid fa-paper-plane" Color="primary">1,284 today</MiniCard></div>
        <div class="col-6 col-md-3"><MiniCard Title="Spend" Icon="fa-solid fa-coins" Color="warning">$17.40 this month</MiniCard></div>
        <div class="col-6 col-md-3"><MiniCard Title="Errors" Icon="fa-solid fa-triangle-exclamation" Color="danger">3 failed calls</MiniCard></div>
        <div class="col-6 col-md-3"><MiniCard Title="Cache" Icon="fa-solid fa-database" Color="info">92% hit rate</MiniCard></div>
    </div>
</DemoBlock>

<DemoBlock Title="SettingRow" Introduction="Two settings per visual row — label + help tooltip left, control right." Name="SettingRow">
    <div class="row g-2">
        <SettingRow Label="Display currency" Help="ISO-4217 code used for price headlines.">
            <BootstrapInput TValue="string" Value='@("USD")' ShowLabel="false" />
        </SettingRow>
        <SettingRow Label="Show favourites first" Help="Pins starred models to the top of lists.">
            <Switch Value="true" OnText="Yes" OffText="No" />
        </SettingRow>
        <SettingRow Label="System prompt" Full="true" Help="Applied to every chat request.">
            <Textarea TValue="string" rows="2" Value="You are a helpful assistant." ShowLabel="false" />
        </SettingRow>
    </div>
</DemoBlock>

<DemoBlock Title="ChoiceGroup" Introduction="Segmented single-choice buttons." Name="ChoiceGroup">
    <ChoiceGroup Label="Theme" Items="_themeItems" Value="@_theme" ValueChanged="OnThemeChanged" />
</DemoBlock>

<DemoBlock Title="EmojiPicker" Introduction="Categorised emoji picker dropdown." Name="EmojiPicker">
    <EmojiPicker @bind-Value="_emoji" Placeholder="Pick an emoji" />
    <span class="ms-2">@_emoji</span>
</DemoBlock>

<DemoBlock Title="SpringSelect" Introduction="Collapsed chip that springs open into a select on demand." Name="SpringSelect">
    <SpringSelect Items="_springItems" Selected="@_spring" SelectedChanged="OnSpringChanged" Title="Models" />
</DemoBlock>

<DemoBlock Title="DrawerHeader / DrawerFooter / DrawerTabStrip" Introduction="Drawer chrome — pin/close header, footer slot, and panel tab strip." Name="DrawerChrome">
    <div class="border rounded p-2" style="max-width: 480px;">
        <DrawerHeader Title="Provider settings" Icon="fa-solid fa-plug" ShowPin="true" IsPinned="@_pinned" OnClose="() => { }" OnPin="() => _pinned = !_pinned" />
        <div class="p-3 small text-body-secondary">Drawer body goes here.</div>
        <DrawerTabStrip Panels="_panels" ActivePanel="@_panel" ActivePanelChanged="OnPanelChanged" />
        <DrawerFooter>
            <Button Color="Color.Secondary" Size="Size.Small">Cancel</Button>
            <Button Color="Color.Primary" Size="Size.Small">Save</Button>
        </DrawerFooter>
    </div>
</DemoBlock>

@code {
    private string _query = "";
    private string _view = "card";
    private string _filter = "all";
    private string _sort = "name";
    private string _theme = "system";
    private string? _emoji;
    private string _spring = "llama-3.2";
    private bool _pinned;
    private string _panel = "general";

    private Dictionary<string, string> _filters = new()
    {
        ["all"] = "All",
        ["free"] = "Free",
        ["local"] = "Local",
        ["new"] = "New"
    };

    private Dictionary<string, int> _counts = new()
    {
        ["all"] = 225,
        ["free"] = 68,
        ["local"] = 14,
        ["new"] = 9
    };

    private List<SelectedItem> _sortItems = new()
    {
        new("name", "Name"),
        new("elo", "Arena ELO"),
        new("price", "Price"),
        new("fresh", "Newest")
    };

    private List<SelectedItem> _themeItems = new()
    {
        new("system", "System"),
        new("light", "Light"),
        new("dark", "Dark")
    };

    private List<SpringSelectItem> _springItems = new()
    {
        new("llama-3.2", "Llama 3.2", "fa-solid fa-cube"),
        new("gpt-4o", "GPT-4o", "fa-solid fa-cube"),
        new("claude-sonnet", "Claude Sonnet", "fa-solid fa-cube")
    };

    private List<DrawerPanel> _panels = new()
    {
        new("general", "General", "fa-solid fa-gear"),
        new("keys", "API Keys", "fa-solid fa-key"),
        new("quota", "Quota", "fa-solid fa-chart-pie")
    };

    private void OnQueryChanged(string value) => _query = value;
    private void OnViewChanged(string view) => _view = view;
    private void OnFilterChanged(string filter) => _filter = filter;
    private void OnSortChanged(string sort) => _sort = sort;
    private void OnThemeChanged(string theme) => _theme = theme;
    private void OnSpringChanged(string value) => _spring = value;
    private void OnPanelChanged(string panel) => _panel = panel;
}
