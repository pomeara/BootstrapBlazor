@page "/ai-selectors"
@namespace BootstrapBlazor.Server.Components.Samples
@using BootstrapBlazor.Components

<h3>AI Kit — Selector Molecules</h3>

<DemoBlock Title="ProviderSelect" Introduction="Provider dropdown with online status — fed by a ProviderModelSet list, no catalog coupling." Name="ProviderSelect">
    <ProviderSelect Providers="_sets" SelectedProvider="@_provider" SelectedProviderChanged="OnProviderChanged" />
    <span class="small text-body-secondary ms-2">Selected: @(_provider ?? "—")</span>
</DemoBlock>

<DemoBlock Title="ModelSelect" Introduction="Model dropdown for one provider — favourite/free auto-select, disabled models hidden, per-model atoms in the list. Bind a provider name and the dropdown follows." Name="ModelSelect">
    <ModelSelect Providers="_sets" Provider="@_provider" SelectedModel="@_model" SelectedModelChanged="OnModelChanged" ShowPricing="true" />
    <span class="small text-body-secondary ms-2">Model: @(_model ?? "—")</span>
</DemoBlock>

<DemoBlock Title="ModelSelect (no auto-select)" Introduction="AutoSelect=false keeps a deliberately empty rest state until the user picks." Name="ModelSelectNoAuto">
    <ModelSelect Providers="_sets" Provider="@_provider" SelectedModel="@_manualModel" SelectedModelChanged="OnManualModelChanged" AutoSelect="false" />
    <span class="small text-body-secondary ms-2">Model: @(_manualModel ?? "—")</span>
</DemoBlock>

<DemoBlock Title="GroupedModelSelect" Introduction="Family-grouped model dropdown — grouped by Family with context-window hints and per-model atoms." Name="GroupedModelSelect">
    <GroupedModelSelect Providers="_sets" Provider="@_provider" SelectedModel="@_groupedModel" SelectedModelChanged="OnGroupedModelChanged" />
    <span class="small text-body-secondary ms-2">Model: @(_groupedModel ?? "—")</span>
</DemoBlock>

<DemoBlock Title="CardModelSelector" Introduction="Provider tiles + model card grid — price/size/quantization/context badges per model; the offline tile is visible but not selectable; refresh raises OnRefresh." Name="CardModelSelector">
    <CardModelSelector Providers="_cardSets" Provider="@_cardProvider" ProviderChanged="OnCardProviderChanged"
                       SelectedModel="@_cardModel" SelectedModelChanged="OnCardModelChanged" OnRefresh="OnCardRefresh" />
    <span class="small text-body-secondary ms-2">Model: @(_cardModel ?? "—") @(_cardRefreshed ? "(refreshed)" : "")</span>
</DemoBlock>

<DemoBlock Title="ProviderModelSelector" Introduction="Provider + model dropdown pair for forms and toolbars — picking a provider re-resolves its models with the shared auto-select policy; refresh is a host callback." Name="ProviderModelSelector">
    <ProviderModelSelector Providers="_sets" Provider="@_pmProvider" ProviderChanged="OnPmProviderChanged"
                           SelectedModel="@_pmModel" SelectedModelChanged="OnPmModelChanged" OnRefresh="OnPmRefresh" />
    <span class="small text-body-secondary ms-2">@(_pmProvider ?? "—") / @(_pmModel ?? "—") @(_pmRefreshed ? "(refreshed)" : "")</span>
</DemoBlock>

<DemoBlock Title="NavBarModelSelector" Introduction="Slim provider/model pair for nav bars with a READY/OFFLINE badge for the active provider; model items carry favourite/ELO/tier/state atoms." Name="NavBarModelSelector">
    <NavBarModelSelector Providers="_sets" Provider="@_navProvider" ProviderChanged="OnNavProviderChanged"
                         SelectedModel="@_navModel" SelectedModelChanged="OnNavModelChanged" />
    <div class="small text-body-secondary mt-1">@(_navProvider ?? "—") / @(_navModel ?? "—")</div>
</DemoBlock>

<DemoBlock Title="ProviderSelectorSlim" Introduction="Compact provider icon-chip toolbar — one 36px chip per provider (g4f.dev style); offline chips dim and ignore clicks, favourites carry a star overlay, hover shows label + model count." Name="ProviderSelectorSlim">
    <ProviderSelectorSlim Providers="_sets" SelectedProvider="@_slimProvider" SelectedProviderChanged="OnSlimProviderChanged" />
    <span class="small text-body-secondary ms-2">Selected: @(_slimProvider ?? "—")</span>
</DemoBlock>

<DemoBlock Title="CompactModelPicker" Introduction="One-row model picker for toolbars and nav bars — icon + compact select whose items carry favourite/ELO/tier/state atoms, with an optional ON/OFF badge for the active provider." Name="CompactModelPicker">
    <CompactModelPicker Providers="_sets" Provider="@_provider" SelectedModel="@_compactModel" SelectedModelChanged="OnCompactModelChanged" ShowStatusBadge="true" PlaceHolder="Pick model..." />
    <span class="small text-body-secondary ms-2">Model: @(_compactModel ?? "—")</span>
</DemoBlock>

<DemoBlock Title="ProviderSelectorDetailed" Introduction="Filterable model-card browser (build.nvidia.com style) — search, modality and capability toggles plus free-only drive a responsive card grid; each card shows context, badges and pricing with a Select action." Name="ProviderSelectorDetailed">
    <ProviderSelectorDetailed Models="_detailedModels" SelectedModel="@_detailedModel" SelectedModelChanged="OnDetailedModelChanged" />
    <span class="small text-body-secondary">Selected: @(_detailedModel?.Id ?? "—")</span>
</DemoBlock>

@code {
    private string? _provider = "openrouter";
    private string? _model;
    private string? _manualModel;
    private string? _groupedModel;
    private string? _cardProvider;
    private string? _cardModel;
    private bool _cardRefreshed;
    private string? _pmProvider = "groq";
    private string? _pmModel;
    private bool _pmRefreshed;
    private string? _navProvider;
    private string? _navModel;
    private string? _slimProvider = "openrouter";
    private string? _compactModel;
    private ProviderModelEntry? _detailedModel;

    private List<ProviderModelEntry> _detailedModels => _sets.SelectMany(s => s.Models).ToList();

    private List<ProviderModelSet> _sets = new()
    {
        new()
        {
            Name = "openrouter",
            DisplayName = "OpenRouter",
            IsOnline = true,
            IsFavourite = true,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "meta-llama/llama-3.2-70b", DisplayName = "Llama 3.2 70B", Family = "llama", IsFree = true, Favourite = true, Tier = "best", ArenaElo = 1388, LeaderboardRank = 5, ContextWindow = 131072, Capabilities = { "text", "vision" } },
                new() { Id = "qwen/qwen3-coder", DisplayName = "Qwen3 Coder", Family = "qwen", IsFree = true, Tier = "coding", ContextWindow = 262144, Capabilities = { "text", "code" } },
                new() { Id = "openai/gpt-4o", DisplayName = "GPT-4o", Family = "gpt", State = "disabled", Tier = "fast", ContextWindow = 128000, PricePerMillionInput = 2.5m, Capabilities = { "text", "vision", "audio" } }
            }
        },
        new()
        {
            Name = "groq",
            DisplayName = "Groq",
            IsOnline = true,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "llama-3.1-8b-instant", Family = "llama", IsFree = true, Tier = "fast", ContextWindow = 131072, Capabilities = { "text" } },
                new() { Id = "mixtral-8x7b-32768", Family = "mixtral", PricePerMillionInput = 0.24m, ContextWindow = 32768, Capabilities = { "text" } }
            }
        },
        new()
        {
            Name = "ollama",
            DisplayName = "Ollama (local)",
            IsOnline = false,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "llama3.2:8b", Family = "llama", IsFree = true, ContextWindow = 131072, Capabilities = { "text" } },
                new() { Id = "deepseek-r1:14b", Family = "deepseek", IsFree = true, Tier = "reasoning", ContextWindow = 131072, Capabilities = { "text", "reasoning" } }
            }
        }
    };

    private void OnProviderChanged(string? value)
    {
        _provider = value;
        _model = null;
        _manualModel = null;
        _groupedModel = null;
    }

    private void OnModelChanged(string? value) => _model = value;
    private void OnManualModelChanged(string? value) => _manualModel = value;
    private void OnGroupedModelChanged(string? value) => _groupedModel = value;

    private void OnCardProviderChanged(string? value) => _cardProvider = value;
    private void OnCardModelChanged(string? value) => _cardModel = value;
    private Task OnCardRefresh() { _cardRefreshed = true; return Task.CompletedTask; }

    private void OnPmProviderChanged(string? value)
    {
        _pmProvider = value;
        _pmModel = null;
    }
    private void OnPmModelChanged(string? value) => _pmModel = value;
    private Task OnPmRefresh() { _pmRefreshed = true; return Task.CompletedTask; }

    private void OnNavProviderChanged(string? value)
    {
        _navProvider = value;
        _navModel = null;
    }
    private void OnNavModelChanged(string? value) => _navModel = value;

    private void OnSlimProviderChanged(string? value) => _slimProvider = value;
    private void OnCompactModelChanged(string? value) => _compactModel = value;
    private void OnDetailedModelChanged(ProviderModelEntry? value) => _detailedModel = value;

    // Card selector gets enriched local-runtime metadata (sizes, quantization) that only
    // card surfaces show; the dropdown demos reuse _sets as-is.
    private List<ProviderModelSet> _cardSets = new()
    {
        new()
        {
            Name = "ollama",
            DisplayName = "Ollama",
            IsOnline = true,
            IsFavourite = true,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "llama3.2:8b", Family = "llama", IsFree = true, Favourite = true, ContextWindow = 131072, ParameterCount = "8B", SizeBytes = 4_700_000_000, Quantization = "Q4_K_M" },
                new() { Id = "deepseek-r1:14b", Family = "deepseek", IsFree = true, Tier = "reasoning", ContextWindow = 131072, ParameterCount = "14B", SizeBytes = 9_000_000_000, Quantization = "Q4_K_M" },
                new() { Id = "qwen3-coder:30b", Family = "qwen", IsFree = true, Tier = "coding", ContextWindow = 262144, ParameterCount = "30B", SizeBytes = 19_000_000_000, Quantization = "Q3_K_L" }
            }
        },
        new()
        {
            Name = "groq",
            DisplayName = "Groq",
            IsOnline = true,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "llama-3.1-8b-instant", Family = "llama", IsFree = true, Tier = "fast", ContextWindow = 131072, ParameterCount = "8B" },
                new() { Id = "mixtral-8x7b-32768", Family = "mixtral", PricePerMillionInput = 0.24m, ContextWindow = 32768, ParameterCount = "8x7B" }
            }
        },
        new()
        {
            Name = "zhipu",
            DisplayName = "z.ai",
            IsOnline = false,
            Models = new List<ProviderModelEntry>
            {
                new() { Id = "glm-5.3-flash", Family = "glm", IsFree = true, ContextWindow = 200000 }
            }
        }
    };
}
