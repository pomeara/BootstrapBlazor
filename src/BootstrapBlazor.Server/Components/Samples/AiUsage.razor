@page "/ai-usage"
@using BootstrapBlazor.Components

<PageTitle>AI Usage Cards</PageTitle>

<Row>
    <div class="col-md-6">
        <DemoBlock Title="Provider Quota Card" Introduction="Token/request/cost progress bars for one provider API key, with the quota-exceeded badge and an optional health chip.">
            <div class="row g-3">
                <div class="col-lg-6">
                    <ProviderQuotaCard Status="@_healthyQuota" Health="@_healthyHealth" />
                </div>
                <div class="col-lg-6">
                    <ProviderQuotaCard Status="@_nearLimitQuota" Health="@_degradedHealth" />
                </div>
            </div>
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Usage Summary Card" Introduction="Requests, tokens, cost and model diversity over the period; the key-prefix chip appears only for a specific API key.">
            <UsageSummaryCard Summary="@_usageSummary" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Live Quota Card" Introduction="Window bars (5h + weekly/monthly when reported) with the heat shell — border, tint and glow follow severity; the limited card pulses.">
            <div class="row g-3">
                <div class="col-12">
                    <LiveQuotaCard Quota="@_warmLiveQuota" />
                </div>
                <div class="col-lg-6">
                    <LiveQuotaCard Quota="@_limitedLiveQuota" />
                </div>
                <div class="col-lg-6">
                    <LiveQuotaCard Quota="@_errorLiveQuota" />
                </div>
                <div class="col-12">
                    <LiveQuotaCard Quota="@_warmLiveQuota" Detail="LiveQuotaDetailLevel.Compact" />
                </div>
            </div>
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Live Quota Strip" Introduction="One-line per-provider badges (5h % + monthly %) sized for nav bars, page headers and footers.">
            <LiveQuotaStrip Quotas="@_stripQuotas" />
            <div class="mt-3">
                <LiveQuotaStrip Quotas="@(_stripQuotas.Take(0).ToList())" />
            </div>
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Provider Status Grid" Introduction="Provider tiles with online/offline badges and model counts; clicking a tile raises OnProviderSelected.">
            <div class="text-body-secondary small mb-2">@_selectedProvider is selected</div>
            <ProviderStatusGrid ProviderStatuses="@_providerStatuses" OnProviderSelected="p => _selectedProvider = p" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Provider Fallback Chain" Introduction="The resolver's exact candidate order (requested → favourites → fallbacks) with a favourite toggle per step — the editor IS the configuration surface.">
            <ProviderFallbackChainView Candidates="@_chain" OnFavouriteChanged="@OnChainToggle" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Agent Usage Summary Card" Introduction="KPI totals + cost buckets for one scanned agent, with the cost strategy in the footer.">
            <AgentUsageSummaryCard Report="@_agentReport" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Agent Cost Breakdown Card" Introduction="Reported vs computed vs effective cost per model — the opus-fallback fix made visible.">
            <AgentCostBreakdownCard Cost="@_agentReport.Cost" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Agent Disk Usage Card" Introduction="Top-level entries under the agent's base directory with sizes and safe-to-delete / keep badges.">
            <AgentDiskUsageCard Disk="@_diskReport" />
        </DemoBlock>
    </div>
    <div class="col-md-6">
        <DemoBlock Title="Agent Project Usage Card" Introduction="Message/session attribution per project derived from the agent's history log.">
            <AgentProjectUsageCard Projects="@_projectUsage" />
        </DemoBlock>
    </div>
</Row>

