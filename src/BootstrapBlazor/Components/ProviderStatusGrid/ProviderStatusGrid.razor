@namespace BootstrapBlazor.Components

<div class="provider-status-grid card border shadow-sm h-100">
    <div class="card-header bg-transparent border-bottom py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa-solid fa-chart-bar me-2" style="color: var(--bs-warning, #ffc107);"></i>Provider Status
        </h5>
    </div>
    <div class="card-body">
        <Row ItemsPerRow="ItemsPerRow.Three" RowType="RowType.Normal">
            @foreach (var status in ProviderStatuses)
            {
                <div class="mb-3">
                    <div class="card" @onclick="@(() => OnProviderSelected.InvokeAsync(status.ProviderType))" role="button">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(status.IconPath))
                                    {
                                        <img src="@status.IconPath" class="provider-icon me-2" alt="@status.ProviderType" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-server me-2 text-body-secondary"></i>
                                    }
                                    <span class="fw-bold">@status.Name</span>
                                </div>
                                <Badge Color="@(status.IsAvailable ? Color.Success : Color.Danger)">
                                    @(status.IsAvailable ? "Online" : "Offline")
                                </Badge>
                            </div>
                            @if (status.IsAvailable)
                            {
                                <div class="text-body-secondary small mt-1">
                                    @status.ModelCount models
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </Row>
    </div>
</div>
