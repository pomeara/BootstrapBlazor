@namespace BootstrapBlazor.Components
@inherits BootstrapComponentBase

@* Compact status indicator for navigation bars. *@
<span @attributes="AdditionalAttributes" class="@ClassString">
    <i class="fa-solid @Icon me-1 text-@ColorClass"></i>
    <span class="navbar-stat-value">@Value</span>
    <span class="navbar-stat-label">@Label</span>
</span>
